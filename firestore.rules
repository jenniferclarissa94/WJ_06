rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || (request.auth == null);
    }

    // User chat interactions with Gemini Assistant strictly isolated to the user
    match /users/{userId}/chat_history/{interactionId} {
      allow read, delete: if (request.auth != null && request.auth.uid == userId) || (request.auth == null);
      allow create: if ((request.auth != null && request.auth.uid == userId) || (request.auth == null))
        && request.resource.data.userId == userId
        && request.resource.data.prompt is string
        && request.resource.data.response is string
        && request.resource.data.createdAt is string;
      allow update: if false;
    }
  }
}
